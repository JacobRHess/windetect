(EventCode=4688 OR EventCode=1) ((CommandLine="*comsvcs*" AND CommandLine="*MiniDump*") OR (CommandLine="*procdump*" AND CommandLine="*lsass*") OR CommandLine="*sekurlsa*" OR CommandLine="*mimikatz*" OR CommandLine="*nanodump*" OR (CommandLine="*lsass*" AND CommandLine="*.dmp*"))
| stats count as dump_events
    values(CommandLine) as command_lines
    values(EventCode) as event_codes
    values(Computer) as hosts
    min(_time) as first_seen
    max(_time) as last_seen
| where dump_events > 0
| eval detection="lsass-dump-command-line", technique="T1003.001"
